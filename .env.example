# MongoDB
MONGO_URI=mongodb://localhost:27017/parus_kitchen

# JWT
JWT_SECRET=your_jwt_secret_here

# Frontend URL (used in reset links)
FRONTEND_URL=http://localhost:5173

# SMTP (for sending password reset emails)
# For development, use Mailtrap credentials or Gmail app password
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
EMAIL_USER=your_mailtrap_username_or_smtp_user
EMAIL_PASS=your_mailtrap_password_or_smtp_pass
EMAIL_FROM="Parus Kitchen <no-reply@paruskitchen.com>"

# Optional: override transporter defaults
# EMAIL_FROM=your-from-address
